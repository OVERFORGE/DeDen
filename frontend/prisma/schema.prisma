// Decentralized Den - Production-Ready Prisma Schema
// ✅ UPDATED: Added Reservation System for 2+ nights bookings
// Version: 4.0 - MongoDB Optimized

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// NEXTAUTH ADAPTER MODELS - Required for authentication
// ============================================================================

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// ENUMS - Type-safe status values
// ============================================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  RESERVED      // ✅ NEW: After $30 reservation paid, awaiting remaining payment
  CANCELLED
  REFUNDED
  EXPIRED
  FAILED
}

enum PaymentToken {
  USDC
  USDT
}

enum RoomType {
  SHARED
  PRIVATE
  SUITE
}

enum UserRole {
  GUEST
  ADMIN
  HOST
  SPONSOR
}

// ============================================================================
// USER MODEL - Authentication, profile, and privacy
// ============================================================================

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  // Authentication - NextAuth fields
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  
  // Web3 Authentication
  walletAddress   String?
  
  // Profile Information
  displayName     String?
  firstName       String?
  lastName        String?
  role            String?
  bio             String?
  avatar          String?
  gender          String?
  age             Int?
  mobileNumber    String?
  
  // Social Links
  socialTwitter   String?
  socialTelegram  String?
  socialLinkedin  String?
  socialGithub    String?
  socialWebsite   String?
  
  // Privacy & Preferences
  optInGuestList      Boolean   @default(false)
  optInEmailMarketing Boolean   @default(false)
  shareContactInfo    Boolean   @default(false)
  contentReuseConsent Boolean   @default(false)
  
  // System
  userRole        UserRole  @default(GUEST)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  
  // NextAuth Relations
  accounts        Account[]
  sessions        Session[]
  
  // App Relations
  bookings        Booking[]
  reviews         Review[]
  refunds         Refund[]
  activities      ActivityLog[]
  tickets         Ticket[]

  // Metadata
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userRole])
  @@index([createdAt])
  @@index([walletAddress])
}

// ============================================================================
// STAY MODEL - The core product/event
// ============================================================================

model Stay {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  stayId          String    @unique
  
  // Basic Information
  title           String
  slug            String    @unique
  description     String    @default("")
  shortDescription String?
  location        String
  venue           String?
  enabledChains   Int[]     @default([]) // e.g., [42161, 56, 8453, 5003]
  // Dates & Duration (NIGHTS)
  startDate       DateTime
  endDate         DateTime
  duration        Int
  
  // Capacity
  slotsTotal      Int
  slotsAvailable  Int
  guestCapacity   Int?
  
  // Pricing PER NIGHT (used as default for rooms)
  priceUSDC       Float
  priceUSDT       Float
  currency        String    @default("USD")
  depositAmount   Float?
  
  // ✅ NEW: Reservation Configuration
  requiresReservation Boolean   @default(false)  // Enable reservation system
  reservationAmount   Float     @default(30)     // Default $30 reservation
  minNightsForReservation Int   @default(2)      // Minimum nights to require reservation
  
  // Media & Gallery
  heroImage       String?
  galleryImages   String[]  @default([])
  images          String[]  @default([])
  videoUrl        String?
  
  // Rooms Configuration (prices are PER NIGHT)
  rooms           Json[]    @default([])
  
  // Amenities & Features
  amenities       String[]  @default([])
  programHighlights Json?
  amenityIcons      Json?   @default("[]")
  highlights        String[] @default([])
  rules             String[] @default([])
  
  // Logistics
  checkInTime     String?
  checkOutTime    String?
  address         Json?
  
  // Configuration
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  allowWaitlist   Boolean   @default(true)
  autoConfirm     Boolean   @default(false)

  // When on, a fresh application lands as WAITLISTED instead of going
  // straight to the payment page — an admin has to approve it first
  // (app/api/admin/bookings/[bookingId]/approve), which is what actually
  // sends the "complete your payment" email. Off by default so existing
  // stays keep today's instant-pay behavior. Only applies to brand-new
  // applications, not extensions to a booking that's already past WAITLISTED.
  requiresApproval Boolean  @default(false)
  // When on, guests with an accepted booking can see who else is attending
  // (name + X handle only, and only for guests who opted in themselves).
  guestListEnabled Boolean  @default(false)

  // When off, the flat 20% returning-guest loyalty discount (lib/pricing.ts)
  // never applies to this stay, regardless of the guest's booking history —
  // e.g. for a sponsored/already-discounted or capacity-constrained event
  // where stacking loyalty on top doesn't make sense. On by default so
  // existing stays keep today's behavior.
  loyaltyDiscountEnabled Boolean @default(true)

  // When off (default), every guest books the whole event window and the
  // apply form shows fixed dates. When on, guests pick their own check-in /
  // check-out inside [startDate, endDate] and are priced per night for the
  // range they chose. Off by default so existing conference-style stays are
  // unaffected.
  allowFlexibleDates Boolean @default(false)

  // Optional MANDATORY CORE inside the stay window — the nights every guest
  // must book (e.g. the actual conference days). Only meaningful when
  // allowFlexibleDates is on: the guest's chosen range must fully contain
  // [coreStartDate, coreEndDate], but they may extend earlier and/or later
  // up to [startDate, endDate]. Leave null for "any range in the window".
  coreStartDate   DateTime?
  coreEndDate     DateTime?

  status          String    @default("UPCOMING") // UPCOMING, ONGOING, DONE
  
  // Past Event Details
  testimonials    Json[]    @default([])
  
  // Cancellation Policy
  refundableUntil DateTime?
  cancellationPolicy Json?
  
  // SEO & Marketing
  metaTitle       String?
  metaDescription String?
  tags            String[]  @default([])
  
  // Relations
  bookings        Booking[]
  sponsors        Sponsor[]   @relation(fields: [sponsorIds], references: [id])
  sponsorIds      String[]    @db.ObjectId
  reviews         Review[]
  addons          Addon[]
  referralCodes   ReferralCode[]
  tickets         Ticket[]
  
  // Metadata
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([startDate])
  @@index([isPublished, isFeatured])
  @@index([tags])
  @@index([duration])
}

// ============================================================================
// REFERRAL CODE MODEL - Community Referral System
// ============================================================================

model ReferralCode {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  // Community Info
  communityName   String
  code            String    @unique
  
  // Link to specific stay/event
  stay            Stay      @relation(fields: [stayId], references: [id])
  stayId          String    @db.ObjectId
  
  // Discount Configuration
  discountPercent Int       @default(10)
  
  // Usage Tracking
  usageCount      Int       @default(0)
  maxUsage        Int?
  
  // Status
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  
  // Relations
  bookings        Booking[]
  
  // Metadata
  notes           String?
  createdBy       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([stayId])
  @@index([communityName])
  @@index([isActive])
}

// ============================================================================
// BOOKING MODEL - Core transaction/reservation
// ✅ UPDATED: Added reservation payment fields and RESERVED status
// ============================================================================

model Booking {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String        @unique
  
  // Relations
  user            User          @relation(fields: [userId], references: [id])
  userId          String        @db.ObjectId
  stay            Stay          @relation(fields: [stayId], references: [id])
  stayId          String        @db.ObjectId
  
  // Guest Info
  guestGender     String?
  guestAge        Int?
  guestMobile     String?
  preferredRoomId String?
  
  // Booking Details
  status          BookingStatus @default(PENDING)
  roomType        RoomType?
  selectedRoomId  String?
  guestCount      Int           @default(1)
  
  // Nights-Based Pricing Fields with Check-In/Out Dates
  numberOfNights      Int?
  checkInDate         DateTime?
  checkOutDate        DateTime?
  pricePerNightUSDC   Float?
  pricePerNightUSDT   Float?
  
  // Total Prices
  selectedRoomPriceUSDC Float?
  selectedRoomPriceUSDT Float?
  selectedRoomName      String?
  
  // Guest Info Snapshot
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guests          Json[]        @default([])
  
  
  // Referral Code & Discount Tracking
  referralCode     ReferralCode?  @relation(fields: [referralCodeId], references: [id])
  referralCodeId   String?        @db.ObjectId
  referralCodeUsed String?
  
  discountPercent  Int?
  discountAmount   Float?
  originalPrice    Float?
  finalPrice       Float?
  
  isLoyaltyDiscount Boolean       @default(false)
  
  // Reservation Payment Fields
  requiresReservation    Boolean   @default(false)
  reservationAmount      Float?
  reservationPaid        Boolean   @default(false)
  reservationTxHash      String?
  reservationPaidAt      DateTime?
  reservationChainId     Int?
  reservationToken       String?
  
  remainingAmount        Float?
  remainingPaid          Boolean   @default(false)
  remainingTxHash        String?
  remainingPaidAt        DateTime?
  remainingChainId       Int?
  remainingToken         String?
  
  remainingDueDate       DateTime?
  remainingPaymentSent   Boolean   @default(false)
  
  // Original Payment Information
  paymentToken    PaymentToken?
  paymentAmount   Float?
  amountBaseUnits String?
  chain           String?
  chainId         Int?
  txHash          String?
  blockNumber     Int?
  
  // Payment Details
  senderAddress   String?
  receiverAddress String?
  gasUsed         String?
  gasFeeUSD       Float?
  
  // Session Management
  sessionToken    String?
  expiresAt       DateTime?
  confirmedAt     DateTime?
  
  // Add-ons
  selectedAddons  String[]      @db.ObjectId
  addonsTotal     Float         @default(0)
  
  // Pricing Breakdown
  subtotal        Float?
  serviceFee      Float         @default(0)
  totalPaid       Float?
  
  // Privacy & Consent
  optInGuestList      Boolean   @default(false)
  shareContactInfo    Boolean   @default(false)
  contentReuseConsent Boolean   @default(false)
  
  // Travel Assistance
  needsTravelHelp Boolean       @default(false)
  travelNotes     String?
  
  // Admin Notes
  adminNotes      String?
  internalTags    String[]      @default([])
  
  // ✅ ✅ ✅ NFT TICKET FIELDS ✅ ✅ ✅
  nftMinted          Boolean   @default(false)  // ✅ NOT nullable, default false
  nftTokenId         String?                    // ✅ Nullable - will be set after minting
  nftContractAddress String?                    // Set once a claim voucher exists (not only after minting)
  nftTxHash          String?                    // ✅ Optional - transaction hash of minting
  nftMintedAt        DateTime?                  // ✅ ADDED: When NFT was minted

  // Self-claim voucher — the guest mints (and pays gas for) their own NFT by
  // calling claimNFT() on-chain with this signature. Signing costs nothing,
  // so this is always issued on payment confirmation; nftMinted only flips
  // true once the guest actually claims it (see claim-confirm route).
  nftClaimable        Boolean   @default(false)
  nftVoucherSignature String?
  nftVoucherExpiry    DateTime?
  nftMetadataURI      String?
  
  // Relations
  refund          Refund?
  activities      ActivityLog[]
  tickets         Ticket[]

  // Metadata
  metadata        Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, stayId])
  @@index([userId])
  @@index([stayId])
  @@index([status])
  @@index([confirmedAt])
  @@index([createdAt])
  @@index([txHash])
  @@index([sessionToken])
  @@index([numberOfNights])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([referralCodeId])
  @@index([requiresReservation])
  @@index([reservationPaid])
  @@index([remainingDueDate])
  @@index([nftMinted])           // ✅ ADDED: Index for querying NFT bookings
  @@index([nftTokenId])          // ✅ ADDED: Index for looking up by token ID
}

// ============================================================================
// TICKET MODEL — one per guest, issued on payment confirmation
// ============================================================================

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID
}

model Ticket {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId

  ticketCode      String       @unique // e.g. TKT-{stayId}-{seq}, human-readable

  booking         Booking      @relation(fields: [bookingId], references: [id])
  bookingId       String       @db.ObjectId
  stay            Stay         @relation(fields: [stayId], references: [id])
  stayId          String       @db.ObjectId
  user            User         @relation(fields: [userId], references: [id])
  userId          String       @db.ObjectId

  guestIndex      Int          // position within Booking.guests[]
  guestName       String?
  guestEmail      String?

  qrToken         String       @unique // HMAC-signed, verifiable without a DB round trip
  status          TicketStatus @default(ISSUED)

  checkedInAt     DateTime?
  checkedInBy     String?      // admin/staff userId who scanned it

  // On-chain collectible reference (best-effort, never blocks ticket issuance)
  nftMinted       Boolean      @default(false)
  nftTokenId      String?

  issuedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([bookingId])
  @@index([stayId])
  @@index([userId])
  @@index([status])
}

// ============================================================================
// SPONSOR MODEL
// ============================================================================

model Sponsor {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  name            String
  logo            String?
  website         String?
  description     String?
  
  stays           Stay[]    @relation(fields: [stayIds], references: [id])
  stayIds         String[]  @db.ObjectId
  
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([name])
}

// ============================================================================
// ADDON MODEL
// ============================================================================

model Addon {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  stay            Stay      @relation(fields: [stayId], references: [id])
  stayId          String    @db.ObjectId
  
  name            String
  description     String?
  priceUSDC       Float
  priceUSDT       Float
  
  isAvailable     Boolean   @default(true)
  maxQuantity     Int?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([stayId])
}

// ============================================================================
// REFUND MODEL
// ============================================================================

model Refund {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  booking         Booking   @relation(fields: [bookingId], references: [id])
  bookingId       String    @unique @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @db.ObjectId
  
  amount          Float
  token           PaymentToken
  status          String    @default("requested")
  
  reason          String?
  adminNotes      String?
  
  refundTxHash    String?
  refundedAt      DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([status])
  @@index([userId])
}

// ============================================================================
// REVIEW MODEL
// ============================================================================

model Review {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @db.ObjectId
  stay            Stay      @relation(fields: [stayId], references: [id])
  stayId          String    @db.ObjectId
  
  rating          Int
  title           String?
  comment         String?
  
  isPublished     Boolean   @default(true)
  isVerified      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([stayId, isPublished])
  @@index([rating])
}

// ============================================================================
// ACTIVITY LOG
// ============================================================================

model ActivityLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  user            User?     @relation(fields: [userId], references: [id])
  userId          String?   @db.ObjectId
  booking         Booking?  @relation(fields: [bookingId], references: [id])
  bookingId       String?   @db.ObjectId
  
  action          String
  entity          String
  entityId        String?
  
  details         Json?
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([bookingId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// PROMO CODE MODEL
// ============================================================================

model PromoCode {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  code            String    @unique
  description     String?
  
  discountType    String
  discountValue   Float
  
  maxUses         Int?
  usedCount       Int       @default(0)
  
  validFrom       DateTime
  validUntil      DateTime
  
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([validFrom, validUntil])
}

// ============================================================================
// NOTIFICATION MODEL
// ============================================================================

model Notification {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  recipientEmail  String
  recipientId     String?   @db.ObjectId
  
  type            String
  subject         String
  body            String
  
  status          String    @default("pending")
  sentAt          DateTime?
  error           String?
  
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([status])
  @@index([recipientEmail])
  @@index([createdAt])
}

// ============================================================================
// SYSTEM CONFIG
// ============================================================================

model SystemConfig {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  
  key             String    @unique
  value           String
  description     String?
  
  updatedAt       DateTime  @updatedAt
}

